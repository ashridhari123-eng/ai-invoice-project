# Supabase Postgres connection strings.
#   DATABASE_URL is used by the app at runtime. Use the transaction-mode pooler URL
#   (port 6543, IPv4-only) — copy it from Supabase > Connect > Connection string.
#   DIRECT_URL is used by Prisma CLI for migrations / db push (port 5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Used to encrypt Zoho OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOHO_ENCRYPTION_KEY="change-me"

# Zoho Books OAuth 2.0 client (India region). The redirect URI below MUST be
# registered in the Zoho API Console as an Authorized Redirect URI, and must
# point at your deployed app (e.g. https://your-app.vercel.app/api/zoho/callback).
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REGION="IN"
ZOHO_REDIRECT_URI="https://your-app.vercel.app/api/zoho/callback"

# Used for AI invoice extraction / RFQ award recommendations.
# If unset, the app runs in mock mode.
ANTHROPIC_API_KEY=""
