# SQLite file database (default). Swap to Postgres later via prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Used to encrypt Zoho OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOHO_ENCRYPTION_KEY="change-me"
